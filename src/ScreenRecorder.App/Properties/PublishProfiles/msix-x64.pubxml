<?xml version="1.0" encoding="UTF-8"?>
<!--
  Release MSIX publish profile (x64) intended for DISTRIBUTION builds.

  Expected usage:
    dotnet publish .\src\ScreenRecorder.App\ScreenRecorder.App.csproj -c Release -p:PublishProfile=msix-x64 \
      -p:PackageVersion=1.2.3.4 \
      -p:PackageCertificateKeyFile=..\..\certs\PrismCapture_Distribution.pfx \
      -p:PackageCertificatePassword=%PRISMCAPTURE_PFX_PASSWORD%

  Notes:
  - The certificate Subject must match the Publisher in Package.appxmanifest.
  - Outputs to: src\ScreenRecorder.App\AppPackages\...
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <WindowsPackageType>MSIX</WindowsPackageType>
    <GenerateAppxPackageOnBuild>true</GenerateAppxPackageOnBuild>

    <!-- WinUI/XAML apps are not trim-safe; trimming can break XAML activation at runtime. -->
    <PublishTrimmed>false</PublishTrimmed>

    <!-- Distribution builds should be signed. Key file + password are passed in at build time. -->
    <AppxPackageSigningEnabled>true</AppxPackageSigningEnabled>

    <!-- Optional: avoid bundles unless you explicitly want them. -->
    <AppxBundle>Never</AppxBundle>
  </PropertyGroup>
</Project>

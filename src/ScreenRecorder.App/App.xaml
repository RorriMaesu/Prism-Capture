<?xml version="1.0" encoding="UTF-8" ?>
<Application
    x:Class="ScreenRecorder.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ScreenRecorder.App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>
            <!-- App resources (prefer theme resources over hard-coded colors) -->

            <!--
                Premium Windows 11 surfaces
                Keep values centralized so corners/padding/shadows stay consistent across views.
            -->
            <CornerRadius x:Key="CardCornerRadius">12</CornerRadius>
            <CornerRadius x:Key="SubCardCornerRadius">8</CornerRadius>
            <CornerRadius x:Key="OverlayCardCornerRadius">10</CornerRadius>

            <Thickness x:Key="CardPadding">16</Thickness>
            <Thickness x:Key="SubCardPadding">12</Thickness>
            <Thickness x:Key="OverlayCardPadding">18</Thickness>

            <Style x:Key="CardSurface" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
                <Setter Property="Padding" Value="{StaticResource CardPadding}" />
            </Style>

            <Style x:Key="SubCardSurface" TargetType="Border" BasedOn="{StaticResource CardSurface}">
                <Setter Property="CornerRadius" Value="{StaticResource SubCardCornerRadius}" />
                <Setter Property="Padding" Value="{StaticResource SubCardPadding}" />
            </Style>

            <Style x:Key="OverlayCardSurface" TargetType="Border" BasedOn="{StaticResource CardSurface}">
                <Setter Property="CornerRadius" Value="{StaticResource OverlayCardCornerRadius}" />
                <Setter Property="Padding" Value="{StaticResource OverlayCardPadding}" />
            </Style>

            <Style x:Key="Action" TargetType="Button">
                <Setter Property="Padding" Value="14,10" />
                <Setter Property="CornerRadius" Value="10" />
            </Style>

            <Style x:Key="PrimaryAction" TargetType="Button" BasedOn="{StaticResource Action}">
                <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>

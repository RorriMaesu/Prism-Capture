**/AppPackages/
**/BundleArtifacts/
**/*.appx
**/*.appxbundle
**/*.msix
**/*.msixbundle

# Local artifacts
recordings/
*.part
*.log

# Release bundle outputs (created by scripts/PublishPrismCaptureMsix.ps1 -OutDir ...)
dist/
release/
PrismCapture-*.zip
dist/*.zip
release/*.zip

# Secrets / certs (should not be committed)
*.pfx
*.p12
*.pem
*.key
*.snk
.env

# Optional bundled FFmpeg binaries (drop locally; do not commit)
src/ScreenRecorder.App/External/ffmpeg/*.exe

# Local search outputs (created during setup/troubleshooting)
_ffmpeg_*.txt
_ffprobe_*.txt

# Generated dev signing certificate export (created by scripts/InstallPrismCaptureMsix.ps1)
certs/PrismCapture_Dev.cer

# OS
Thumbs.db
.DS_Store
